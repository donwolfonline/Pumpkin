# Application
PORT=4000
NODE_ENV=production

# Database (AWS RDS)
DATABASE_HOST=pumpkin-prod.cxxxx.us-east-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_USER=pumpkin_admin
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=pumpkin_prod

# Security
JWT_ACCESS_SECRET=CHANGE_ME_LONG_SECURE_STRING
JWT_REFRESH_SECRET=CHANGE_ME_LONG_SECURE_STRING
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Redis (AWS ElastiCache)
REDIS_HOST=pumpkin-cache.cxxxx.cache.amazonaws.com
REDIS_PORT=6379

# Email (Postmark/SES)
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587
EMAIL_USER=api-token
EMAIL_PASS=api-token

# Document Storage (AWS S3)
S3_BUCKET_NAME=pumpkin-documents-prod
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
